{
  "name": "dbc-site",
  "type": "module",
  "version": "0.0.1",
  "scripts": {
    "dev": "astro dev",
    "start": "astro dev",
    "build": "astro check && tsc --noEmit && astro build",
    "preview": "astro preview",
    "deploy": "wrangler deploy",
    "lint": "eslint .",
    "format:check": "prettier --check .",
    "prettify": "prettier --write .",
    "typegen": "SANITY_SCHEMA_EXTRACT=true npx sanity schema extract && sanity typegen generate",
    "devt": "SANITY_SCHEMA_EXTRACT=true npx sanity schema extract && sanity typegen generate && astro dev",
    "astro": "astro"
  },
  "dependencies": {
    "@astrojs/check": "^0.9.10",
    "@astrojs/cloudflare": "^14.3.3",
    "@astrojs/react": "^7.0.0",
    "@fullcalendar/core": "^6.1.21",
    "@fullcalendar/daygrid": "^6.1.21",
    "@fullcalendar/list": "^6.1.21",
    "@fullcalendar/react": "^6.1.21",
    "@fullcalendar/rrule": "^6.1.21",
    "@fullcalendar/timegrid": "^6.1.21",
    "@portabletext/react": "^8.0.1",
    "@sanity/astro": "^3.5.1",
    "@sanity/icons": "^5.2.3",
    "@sanity/image-url": "^2.1.1",
    "@sanity/preview-url-secret": "^4.1.5",
    "@sanity/ui": "^4.3.0",
    "@sanity/util": "^6.17.0",
    "@sanity/vision": "^6.17.0",
    "@sanity/visual-editing": "^5.7.3",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "astro": "^7.3.5",
    "autoprefixer": "10.6.1",
    "groq": "^6.17.0",
    "prettier-plugin-astro": "1.1.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "rrule": "^2.8.1",
    "sanity": "^6.17.0"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^24.19.1",
    "eslint": "^10.11.0",
    "prettier": "3.9.9",
    "typescript": "^6.0.3",
    "vite": "^8.3.2",
    "wrangler": "4.147.0"
  },
  "engines": {
    "node": ">=24.21.0 <25"
  },
  "overrides": {
    "@asamuzakjp/css-color": "4.1.2",
    "@asamuzakjp/dom-selector": "6.8.1"
  },
  "allowScripts": {
    "esbuild@0.28.1": true,
    "workerd@1.20261001.1": true
  }
}
