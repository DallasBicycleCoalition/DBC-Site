{
  "name": "dbc-site",
  "type": "module",
  "version": "0.0.1",
  "scripts": {
    "dev": "astro dev",
    "start": "astro dev",
    "build": "astro check && tsc --noEmit && astro build",
    "preview": "astro preview",
    "deploy": "wrangler deploy",
    "lint": "eslint .",
    "format:check": "prettier --check .",
    "prettify": "prettier --write .",
    "typegen": "SANITY_SCHEMA_EXTRACT=true npx sanity schema extract --force && sanity typegen generate",
    "devt": "SANITY_SCHEMA_EXTRACT=true npx sanity schema extract --force && sanity typegen generate && astro dev",
    "astro": "astro"
  },
  "dependencies": {
    "@astrojs/check": "^0.9.12",
    "@astrojs/cloudflare": "^14.4.6",
    "@astrojs/react": "^7.1.4",
    "@fullcalendar/react": "^7.1.4",
    "@fullcalendar/rrule": "^7.1.4",
    "@portabletext/react": "^8.0.1",
    "@sanity/astro": "^3.6.0",
    "@sanity/client": "^7.28.0",
    "@sanity/icons": "^5.3.0",
    "@sanity/image-url": "^2.1.1",
    "@sanity/preview-url-secret": "^4.1.5",
    "@sanity/ui": "^4.4.10",
    "@sanity/util": "^6.22.0",
    "@sanity/vision": "^6.22.0",
    "@sanity/visual-editing": "^6.2.0",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "astro": "^7.4.7",
    "autoprefixer": "10.6.2",
    "groq": "^6.22.0",
    "prettier-plugin-astro": "1.1.2",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "rrule": "^2.8.1",
    "sanity": "^6.22.0",
    "temporal-polyfill": "^1.0.7"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^24.19.1",
    "eslint": "^10.11.0",
    "prettier": "3.9.9",
    "typescript": "^6.0.3",
    "vite": "^8.3.5",
    "wrangler": "4.156.1"
  },
  "engines": {
    "node": ">=24.21.0 <25"
  },
  "overrides": {
    "@asamuzakjp/css-color": "4.1.2",
    "@asamuzakjp/dom-selector": "6.8.1"
  },
  "allowScripts": {
    "esbuild@0.28.2": true,
    "workerd@1.20261101.1": true
  }
}
