---
import Layout from '../layouts/Layout.astro';

// The Constant Contact widget only initializes once per full page load, so this page skips the client router
---

<Layout title="Join the Email List" clientRouter={false}>
  <section id="email-list-section">
    <div class="ctct-inline-form" data-form-id="f6399a61-27d2-48de-8f52-ac4715e1c6bc"></div>

    <script is:inline>
      var _ctct_m = 'dc63c3d491c7072d7bc823bb48030a29';
    </script>
    <script
      is:inline
      id="signupScript"
      src="https://static.ctctcdn.com/js/signup-form-widget/current/signup-form-widget.min.js"
      async
      defer
    ></script>
  </section>

  <style>
    #email-list-section {
      max-width: 50rem;
      margin: 0 auto;
    }
  </style>
</Layout>
